#!ipxe
# BIOS test profiles -- non-canonical experimental BIOS settings for
# diagnostic testing. Each entry sanboots a separate FAT image built by
# bios-config/tools/build-bios-test-imgs.sh from a profile directory in
# bios-config/scripts/test-profiles/.
#
# This menu is INTENTIONALLY separate from `bios` (which applies the
# canonical 48-setting config). Test profiles change a small focused
# subset of BIOS settings to test specific hypotheses without touching
# the rest of the canonical state. Each "Disable X" test profile has a
# matching "Restore X" revert profile to put the changed knobs back to
# firmware defaults.
#
# Operator flow:
#   1. Disable a test profile (PXE -> bios-test -> Disable X)
#   2. Run measurement (PXE -> nvme -> bench, etc.)
#   3. Restore defaults (PXE -> bios-test -> Restore X)
#   4. (Optional) Re-apply canonical via PXE -> bios -> Apply canonical BIOS
#
# Built in the sibling bios-config repo:
#   cd ~/Documents/github/bios-config && ./tools/build-bios-test-imgs.sh
#   cd ~/Documents/github/truenas-infra && ./manage.sh phase apps --apply

:start
menu bios-test -- experimental BIOS profiles
item --gap -- --- CPU C-state hypothesis ---
item cstate-off       Disable CPU C-states (master + per-state report + pkg limit)
item cstate-restore   Restore C-state defaults (revert)
item --gap -- ---
item back             Back to main menu
choose --timeout 30000 --default cstate-off target || goto back
goto ${target}

# ─── Profile sanboot routes ─────────────────────────────────────────

:cstate-off
echo
echo Applying TEST profile: CPU C-states DISABLED
echo Source: bios-config/scripts/test-profiles/cstate-off/
echo This INCREASES idle power. Revert via 'Restore C-state defaults'.
echo
sanboot --keep ${cache_url}/bios-config/bios-test-cstate-off.img || goto fail
exit

:cstate-restore
echo
echo Applying REVERT profile: C-state defaults restored
echo Source: bios-config/scripts/test-profiles/cstate-restore/
echo
sanboot --keep ${cache_url}/bios-config/bios-test-cstate-restore.img || goto fail
exit

# ─── Failure handling ──────────────────────────────────────────────

:fail
echo
echo ERROR: sanboot of test-profile image failed.
echo
echo Troubleshooting:
echo   * Is the image on the NAS?
echo     curl -I ${cache_url}/bios-config/bios-test-cstate-off.img
echo     curl -I ${cache_url}/bios-config/bios-test-cstate-restore.img
echo
echo   * Rebuild and re-upload (sibling bios-config repo required):
echo     cd ~/Documents/github/bios-config
echo     ./tools/build-bios-test-imgs.sh
echo     cd ~/Documents/github/truenas-infra
echo     ./manage.sh phase apps --apply
echo
prompt Press any key to return to the main menu...
goto back

:back
exit
